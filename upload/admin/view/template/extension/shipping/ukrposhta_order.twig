{% if is_ukrposhta %}
<div class="panel panel-default" id="ukrposhta-order-panel">
  <div class="panel-heading">
    <h3 class="panel-title"><i class="fa fa-truck"></i> {{ text_ukrposhta }}</h3>
  </div>
  <div class="panel-body">
    {% if order_data %}
    <p>
      <strong>{{ order_data.city_name }}</strong>
      {% if order_data.region_name %}, {{ order_data.region_name }}{% endif %}
      {% if order_data.postcode %} — {{ order_data.postcode }}{% endif %}<br/>
      {% if order_data.office_name %}{{ order_data.office_name }}{% endif %}
      {% if order_data.street %}{{ order_data.street }} {{ order_data.house }} {{ order_data.apartment }}{% endif %}
    </p>
    {% else %}
    <p class="text-warning">Немає даних відділення/адреси з checkout. Переконайтесь, що покупець обрав місто та відділення, або передайте postcode вручну через API.</p>
    {% endif %}

    <div class="form-inline" style="margin-bottom:10px;">
      <input type="text" id="ukrposhta-manual-postcode" class="form-control input-sm" placeholder="Індекс одержувача" value="{{ order_data.postcode|default('') }}" style="width:140px; margin-right:6px;"/>
      <button type="button" id="button-ukrposhta-create" class="btn btn-primary"><i class="fa fa-plus"></i> {{ text_create }}</button>
    </div>

    {% if shipments %}
    <div class="table-responsive">
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <td>{{ column_barcode }}</td>
            <td>{{ column_status }}</td>
            <td>{{ column_price }}</td>
            <td>{{ column_date }}</td>
            <td>{{ column_action }}</td>
          </tr>
        </thead>
        <tbody>
          {% for shipment in shipments %}
          <tr>
            <td>{{ shipment.barcode }}<br/><small>{{ shipment.type }} / {{ shipment.delivery_type }}</small></td>
            <td>{{ shipment.status }}</td>
            <td>{{ shipment.delivery_price }}</td>
            <td>{{ shipment.date_added }}</td>
            <td class="text-right">
              <a href="{{ sticker_url }}&shipment_id={{ shipment.shipment_id }}" target="_blank" class="btn btn-info btn-xs"><i class="fa fa-print"></i> {{ text_sticker }}</a>
              <button type="button" class="btn btn-default btn-xs button-ukrposhta-track" data-id="{{ shipment.shipment_id }}"><i class="fa fa-refresh"></i> {{ text_track }}</button>
              <button type="button" class="btn btn-danger btn-xs button-ukrposhta-delete" data-id="{{ shipment.shipment_id }}"><i class="fa fa-trash"></i> {{ text_delete }}</button>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="text-muted">{{ text_no_shipments }}</p>
    {% endif %}
    <div id="ukrposhta-order-alert"></div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-ukrposhta-create').on('click', function() {
  var $btn = $(this);
  $btn.prop('disabled', true);
  $.ajax({
    url: '{{ create_url|e('js') }}',
    type: 'post',
    data: { postcode: $('#ukrposhta-manual-postcode').val() },
    dataType: 'json',
    success: function(json) {
      if (json.error) {
        $('#ukrposhta-order-alert').html('<div class="alert alert-danger">' + json.error + '</div>');
      }
      if (json.success) {
        $('#ukrposhta-order-alert').html('<div class="alert alert-success">' + json.success + '</div>');
        setTimeout(function() { location.reload(); }, 800);
      }
    },
    complete: function() { $btn.prop('disabled', false); }
  });
});

$('.button-ukrposhta-track').on('click', function() {
  var id = $(this).data('id');
  $.ajax({
    url: '{{ track_url|e('js') }}&shipment_id=' + id,
    dataType: 'json',
    success: function(json) {
      if (json.error) {
        $('#ukrposhta-order-alert').html('<div class="alert alert-danger">' + json.error + '</div>');
      }
      if (json.success) {
        $('#ukrposhta-order-alert').html('<div class="alert alert-success">' + json.success + '</div>');
        setTimeout(function() { location.reload(); }, 800);
      }
    }
  });
});

$('.button-ukrposhta-delete').on('click', function() {
  if (!confirm('Delete shipment?')) return;
  var id = $(this).data('id');
  $.ajax({
    url: '{{ delete_url|e('js') }}&shipment_id=' + id,
    dataType: 'json',
    success: function(json) {
      if (json.error) {
        $('#ukrposhta-order-alert').html('<div class="alert alert-danger">' + json.error + '</div>');
      }
      if (json.success) {
        location.reload();
      }
    }
  });
});
//--></script>
{% endif %}
