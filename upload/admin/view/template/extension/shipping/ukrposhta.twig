{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-api" data-toggle="tab">{{ tab_api }}</a></li>
            <li><a href="#tab-sender" data-toggle="tab">{{ tab_sender }}</a></li>
            <li><a href="#tab-methods" data-toggle="tab">{{ tab_methods }}</a></li>
            <li><a href="#tab-payment" data-toggle="tab">{{ tab_payment }}</a></li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-general">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_status" id="input-status" class="form-control">
                    {% if shipping_ukrposhta_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_geo_zone_id" id="input-geo-zone" class="form-control">
                    <option value="0">{{ text_all_zones }}</option>
                    {% for geo_zone in geo_zones %}
                    {% if geo_zone.geo_zone_id == shipping_ukrposhta_geo_zone_id %}
                    <option value="{{ geo_zone.geo_zone_id }}" selected="selected">{{ geo_zone.name }}</option>
                    {% else %}
                    <option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-tax-class">{{ entry_tax_class }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_tax_class_id" id="input-tax-class" class="form-control">
                    <option value="0">{{ text_none }}</option>
                    {% for tax_class in tax_classes %}
                    {% if tax_class.tax_class_id == shipping_ukrposhta_tax_class_id %}
                    <option value="{{ tax_class.tax_class_id }}" selected="selected">{{ tax_class.title }}</option>
                    {% else %}
                    <option value="{{ tax_class.tax_class_id }}">{{ tax_class.title }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_sort_order" value="{{ shipping_ukrposhta_sort_order }}" id="input-sort-order" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-api-calc">{{ entry_api_calc }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_api_calc" id="input-api-calc" class="form-control">
                    {% if shipping_ukrposhta_api_calc %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-fallback">{{ entry_fallback_cost }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_fallback_cost" value="{{ shipping_ukrposhta_fallback_cost }}" id="input-fallback" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-free">{{ entry_free_total }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_free_total" value="{{ shipping_ukrposhta_free_total }}" id="input-free" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-min-order">{{ entry_min_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_min_order" value="{{ shipping_ukrposhta_min_order }}" id="input-min-order" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-max-order">{{ entry_max_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_max_order" value="{{ shipping_ukrposhta_max_order }}" id="input-max-order" class="form-control"/>
                </div>
              </div>
            </div>

            <div class="tab-pane" id="tab-api">
              <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ help_tokens }}</div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-bearer">{{ entry_bearer_ecom }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_bearer_ecom" value="{{ shipping_ukrposhta_bearer_ecom }}" id="input-bearer" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-bearer-track">{{ entry_bearer_tracking }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_bearer_tracking" value="{{ shipping_ukrposhta_bearer_tracking }}" id="input-bearer-track" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-token">{{ entry_token }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_token" value="{{ shipping_ukrposhta_token }}" id="input-token" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sandbox">{{ entry_sandbox }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_sandbox" id="input-sandbox" class="form-control">
                    {% if shipping_ukrposhta_sandbox %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-debug">{{ entry_debug }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_debug" id="input-debug" class="form-control">
                    {% if shipping_ukrposhta_debug %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-timeout">{{ entry_timeout }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_timeout" value="{{ shipping_ukrposhta_timeout }}" id="input-timeout" class="form-control"/>
                </div>
              </div>
            </div>

            <div class="tab-pane" id="tab-sender">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sender-uuid">{{ entry_sender_uuid }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_sender_uuid" value="{{ shipping_ukrposhta_sender_uuid }}" id="input-sender-uuid" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sender-postcode">{{ entry_sender_postcode }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_sender_postcode" value="{{ shipping_ukrposhta_sender_postcode }}" id="input-sender-postcode" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-default-weight">{{ entry_default_weight }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_default_weight" value="{{ shipping_ukrposhta_default_weight }}" id="input-default-weight" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-min-weight">{{ entry_min_weight }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_min_weight" value="{{ shipping_ukrposhta_min_weight }}" id="input-min-weight" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-length">{{ entry_default_length }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_default_length" value="{{ shipping_ukrposhta_default_length }}" id="input-length" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-width">{{ entry_default_width }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_default_width" value="{{ shipping_ukrposhta_default_width }}" id="input-width" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-height">{{ entry_default_height }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_default_height" value="{{ shipping_ukrposhta_default_height }}" id="input-height" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-min-declared">{{ entry_min_declared }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_min_declared" value="{{ shipping_ukrposhta_min_declared }}" id="input-min-declared" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-description"><span data-toggle="tooltip" title="{{ help_description }}">{{ entry_description }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_description" value="{{ shipping_ukrposhta_description }}" id="input-description" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-middlename">{{ entry_middlename }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_default_middlename" value="{{ shipping_ukrposhta_default_middlename }}" id="input-middlename" class="form-control"/>
                </div>
              </div>
            </div>

            <div class="tab-pane" id="tab-methods">
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_methods }}</label>
                <div class="col-sm-10">
                  <div class="checkbox"><label><input type="checkbox" name="shipping_ukrposhta_method_express_w2w" value="1" {% if shipping_ukrposhta_method_express_w2w %}checked{% endif %}/> {{ entry_method_express_w2w }}</label></div>
                  <div class="checkbox"><label><input type="checkbox" name="shipping_ukrposhta_method_express_w2d" value="1" {% if shipping_ukrposhta_method_express_w2d %}checked{% endif %}/> {{ entry_method_express_w2d }}</label></div>
                  <div class="checkbox"><label><input type="checkbox" name="shipping_ukrposhta_method_standard_w2w" value="1" {% if shipping_ukrposhta_method_standard_w2w %}checked{% endif %}/> {{ entry_method_standard_w2w }}</label></div>
                  <div class="checkbox"><label><input type="checkbox" name="shipping_ukrposhta_method_standard_w2d" value="1" {% if shipping_ukrposhta_method_standard_w2d %}checked{% endif %}/> {{ entry_method_standard_w2d }}</label></div>
                </div>
              </div>
            </div>

            <div class="tab-pane" id="tab-payment">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-paid">{{ entry_paid_by_recipient }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_paid_by_recipient" id="input-paid" class="form-control">
                    {% if shipping_ukrposhta_paid_by_recipient %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-postpay">{{ entry_postpay }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_postpay_enabled" id="input-postpay" class="form-control">
                    {% if shipping_ukrposhta_postpay_enabled %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-cod"><span data-toggle="tooltip" title="{{ help_cod_codes }}">{{ entry_cod_codes }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_ukrposhta_cod_payment_codes" value="{{ shipping_ukrposhta_cod_payment_codes }}" id="input-cod" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sms">{{ entry_sms }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_sms" id="input-sms" class="form-control">
                    {% if shipping_ukrposhta_sms %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-check">{{ entry_check_on_delivery }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_check_on_delivery" id="input-check" class="form-control">
                    {% if shipping_ukrposhta_check_on_delivery %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-add-tracking">{{ entry_add_tracking }}</label>
                <div class="col-sm-10">
                  <select name="shipping_ukrposhta_add_tracking_to_order" id="input-add-tracking" class="form-control">
                    {% if shipping_ukrposhta_add_tracking_to_order %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
