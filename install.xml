<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Ukrposhta API</name>
  <code>ukrposhta_api</code>
  <version>1.0.0</version>
  <author>Cursor Agent</author>
  <link>https://dev.ukrposhta.ua/documentation</link>

  <!-- Admin order info: attach Ukrposhta panel data -->
  <file path="admin/controller/sale/order.php">
    <operation error="skip">
      <search><![CDATA[$this->response->setOutput($this->load->view('sale/order_info', $data));]]></search>
      <add position="before"><![CDATA[
		$data['ukrposhta_order'] = $this->load->controller('extension/shipping/ukrposhta/order');
]]></add>
    </operation>
  </file>

  <file path="admin/view/template/sale/order_info.twig">
    <operation error="skip">
      <search><![CDATA[{{ footer }}]]></search>
      <add position="before"><![CDATA[
{% if ukrposhta_order %}
<div id="ukrposhta-order-inject">{{ ukrposhta_order }}</div>
<script type="text/javascript">
$(function () {
  var $box = $('#ukrposhta-order-inject');
  var $panel = $box.find('#ukrposhta-order-panel');
  if ($panel.length) {
    $('#content .container-fluid').children('.panel').first().after($panel);
  }
  $box.remove();
});
</script>
{% endif %}
]]></add>
    </operation>
  </file>

  <file path="admin/view/template/sale/order_info.tpl">
    <operation error="skip">
      <search><![CDATA[<?php echo $footer; ?>]]></search>
      <add position="before"><![CDATA[
<?php if (!empty($ukrposhta_order)) { echo $ukrposhta_order; } ?>
]]></add>
    </operation>
  </file>

  <!-- Checkout shipping method fields -->
  <file path="catalog/controller/checkout/shipping_method.php">
    <operation error="skip">
      <search><![CDATA[$this->response->setOutput($this->load->view('checkout/shipping_method', $data));]]></search>
      <add position="before"><![CDATA[
		$data['ukrposhta_fields'] = $this->load->controller('extension/shipping/ukrposhta/fields');
]]></add>
    </operation>
  </file>

  <file path="catalog/view/theme/*/template/checkout/shipping_method.twig">
    <operation error="skip">
      <search><![CDATA[<input type="button" value="{{ button_continue }}" id="button-shipping-method"]]></search>
      <add position="before"><![CDATA[
{{ ukrposhta_fields }}
]]></add>
    </operation>
  </file>

  <file path="catalog/view/theme/*/template/checkout/shipping_method.tpl">
    <operation error="skip">
      <search><![CDATA[<input type="button" value="<?php echo $button_continue; ?>" id="button-shipping-method"]]></search>
      <add position="before"><![CDATA[
<?php echo isset($ukrposhta_fields) ? $ukrposhta_fields : ''; ?>
]]></add>
    </operation>
  </file>

  <!-- Save selected city/office into order after confirm -->
  <file path="catalog/controller/checkout/confirm.php">
    <operation error="skip">
      <search><![CDATA[$this->session->data['order_id'] = $this->model_checkout_order->addOrder($order_data);]]></search>
      <add position="after"><![CDATA[
			$this->load->controller('extension/shipping/ukrposhta/persistOrder');
]]></add>
    </operation>
  </file>
</modification>
